        {"temperature": 34.0, "humidite": 59, "jours_surchauffe": 0, "seuil": 35.0, "expected": "jaune", "note": "humidité 59 % : sous le palier de 60 %, aucune pénalité"},
        {"temperature": 40.0, "humidite": 69, "jours_surchauffe": 0, "seuil": 35.0, "expected": "orange", "note": "humidité 69 % : pénalité +0,9 mais pas d'escalade (seuil 70 non atteint)"},
