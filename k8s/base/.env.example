# Secrets de l'application — recopier en k8s/base/.env (FICHIER IGNORÉ PAR GIT)
# puis renseigner les valeurs. Consommé par le secretGenerator de kustomization.yaml.
#
# Générer une clé : php artisan key:generate --show
APP_KEY=base64:CHANGEME
# Générer un secret JWT : php artisan jwt:secret  (ou openssl rand -hex 32)
JWT_SECRET=CHANGEME

# Base MySQL in-cluster
DB_USERNAME=chillnet
DB_PASSWORD=CHANGEME
DB_ROOT_PASSWORD=CHANGEME

# Clé partagée Laravel <-> ai-service (en-tête X-AI-TOKEN)
AI_SERVICE_TOKEN=CHANGEME

# Clés externes optionnelles
WEATHER_API_KEY=
GROQ_API_KEY=

# Reconnaissance faciale Face++ (endpoint US)
FACEPP_API_KEY=
FACEPP_API_SECRET=
